{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "candytarot",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-09-14",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "build": {
    "command": "pnpm run build"
  },
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  }
}
